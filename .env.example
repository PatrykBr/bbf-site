# Set the public site URL for metadata and share links.
NEXT_PUBLIC_SITE_URL=https://www.broncelfurniture.com

# Set these keys to enable PostHog analytics in the browser and on the server.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://t.broncelfurniture.com
# Set this to true to record analytics during local development.
NEXT_PUBLIC_POSTHOG_ENABLE_LOCAL=false
POSTHOG_KEY=

# Set the Resend key and email addresses to send contact enquiries.
RESEND_API_KEY=
RESEND_TO_EMAIL=
RESEND_FROM_EMAIL=contact@mail.broncelfurniture.com

# On hosts other than Vercel, use only an IP header that your trusted proxy overwrites.
# Leave this empty for direct or local hosting. All submissions will share one rate limit.
CONTACT_IP_HEADER=

# Vercel's Turso integration supplies these. Required on production servers.
# With both empty, development uses an in-memory limit.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
