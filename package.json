{
    "name": "bff-new",
    "version": "0.2.0",
    "private": true,
    "packageManager": "bun@1.4.3",
    "engines": {
        "node": "24.x",
        "bun": ">=1.4.3"
    },
    "scripts": {
        "dev": "bun --bun next dev",
        "build": "bun --bun next build",
        "start": "bun --bun next start",
        "lint": "bun --bun eslint . --max-warnings=0",
        "lint:fix": "bun --bun eslint . --fix",
        "typecheck": "bun --bun next typegen && bun --check",
        "format": "bun --bun prettier --write .",
        "format:check": "bun --bun prettier --check .",
        "check": "bun run --parallel lint typecheck test",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "test:coverage": "bun test --coverage",
        "test:integration": "bun test ./tests/contact.integration.ts",
        "test:dev": "bun test ./tests/dev.integration.ts"
    },
    "dependencies": {
        "motion": "^14.3.0",
        "next": "16.4.2",
        "posthog-js": "^1.438.12",
        "posthog-node": "^5.56.2",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "resend": "^6.34.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/bun": "1.4.3",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.4.2",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3"
    },
    "type": "module"
}
